# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Initial Admin Account (Created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=श्री. Dattatraya Aher

# Database file location (defaults to backend/data/pashu_khadya.db)
# DB_PATH=/var/data/pashu_khadya.db

# Seed Demo Data (true = seed sample members & transactions, false = empty database)
SEED_DEMO_DATA=false
