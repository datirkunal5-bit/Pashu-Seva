# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Initial Admin Account (Created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=श्री. Dattatraya Aher

# Database Configuration
# Option 1: Turso Cloud Database (Recommended for Render - 100% Free permanent cloud persistence)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Option 2: Local SQLite file location (defaults to backend/data/pashu_khadya.db)
# DB_PATH=/var/data/pashu_khadya.db

# Seed Demo Data (true = seed sample demo members & entries, false = clean empty production DB)
SEED_DEMO_DATA=false

